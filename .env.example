# Copy to .env.local for development; Docker Compose reads .env.local as well.
DATABASE_URL=postgres://opendashboards:opendashboards@localhost:54329/opendashboards

# Your own OpenAI-compatible inference server. Use the server's actual model id.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:32b
# Optional: a different model for dashboard generation.
# LLM_DASHBOARD_MODEL=
# Optional: bearer key if your inference endpoint requires one.
# LLM_API_KEY=
# Optional: content-free inference timings in the Build panel and server logs.
LLM_PERFORMANCE_METRICS=false

# Production standalone auth: one operator account. Local dev skips auth unless
# AUTH_SECRET is set. Use an HTTPS origin outside loopback.
APP_ORIGIN=http://localhost:3100
# AUTH_PASSWORD=                 # at least 16 characters
# AUTH_SECRET=                   # generate: openssl rand -hex 32
# ENCRYPTION_KEY=                # generate separately: openssl rand -hex 32
# AUTH_USER_ID=dev-user           # set to an existing user's id to preserve ownership
# AUTH_USER_EMAIL=operator@localhost

# Optional existing integrations. None is needed for standalone deployment.
# SUPABASE_URL=
# KMS_KEY_ID=
# KMS_ROLE_ARN=
# DEMO_DATABASE_PASSWORD=
# ENABLE_DEMO_DATA=1

# Optional analytics. Leave unset to send no product telemetry.
# POSTHOG_KEY=
# POSTHOG_HOST=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
